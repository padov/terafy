# Configurações para banco de dados de testes
DB_HOST=localhost
DB_PORT=5433
DB_NAME=terafy_test
DB_USER=test_user
DB_PASSWORD=test_password

# Configurações JWT
JWT_SECRET_KEY=test-secret-key-for-testing-only
JWT_EXPIRATION_DAYS=7
JWT_REFRESH_SECRET=test_refresh_secret_key_for_testing_only

# Configurações de Log (WARNING para reduzir verbosidade nos testes)
LOG_LEVEL=WARNING
LOG_TO_FILE=false
LOG_DIR=./log
LOG_MAX_FILE_SIZE_MB=20
LOG_RETENTION_DAYS=7
LOG_COMPRESS_ROTATED=false

# Outras configurações
# LOG_LEVEL=debug

# OpenAI
OPENAI_API_KEY=
